<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Adapted from irobot_create_description (Humble); see NOTICE for commit/license. Local mesh paths; runtime sensors/control are in turtlebot4.gazebo.xacro. -->
  <xacro:macro name="button" params="name parent_link:=base_link *origin">
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${name}"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <link name="${name}"/>
  </xacro:macro>
</robot>
