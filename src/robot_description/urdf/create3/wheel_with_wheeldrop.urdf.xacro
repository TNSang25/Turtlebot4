<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Adapted from irobot_create_description (Humble); see NOTICE for commit/license. Local mesh paths; runtime sensors/control are in turtlebot4.gazebo.xacro. -->
  <xacro:macro name="wheel_with_wheeldrop" params="name gazebo namespace parent_link:=base_link *origin">
    <xacro:include filename="wheel.urdf.xacro"/>
    <xacro:include filename="wheel_drop.urdf.xacro"/>
    <!-- Wheel Drop definition -->
    <xacro:wheel_drop name="${name}" gazebo="${gazebo}" parent_link="${parent_link}" namespace="${namespace}">
      <xacro:insert_block name="origin"/>
    </xacro:wheel_drop>
    <!-- Wheel definition -->
    <xacro:wheel name="${name}" gazebo="${gazebo}" parent_link="wheel_drop_${name}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:wheel>
  </xacro:macro>
</robot>
