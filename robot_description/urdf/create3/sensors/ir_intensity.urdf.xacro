<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Adapted from irobot_create_description (Humble); see NOTICE for commit/license. Local mesh paths; runtime sensors/control are in turtlebot4.gazebo.xacro. -->
  <xacro:include filename="../common_properties.urdf.xacro"/>
  <xacro:macro name="ir_intensity" params="name gazebo namespace parent:=base_link                        update_rate:=62.0 fov:=${10*deg2rad}                        min_range:=${25*mm2m} max_range:=${200*mm2m}                        visualize:=false *origin">
    <xacro:property name="link_name" value="ir_intensity_${name}"/>
    <joint name="${link_name}_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${link_name}"/>
    </joint>
    <link name="${link_name}">
      <xacro:inertial_dummy/>
    </link>
    <gazebo reference="${link_name}_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
  </xacro:macro>
</robot>
