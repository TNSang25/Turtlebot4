<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Local simulator adapter. Official geometry, joints, spring/contact
       settings and frames are in standard/ and create3/.
       World owns Physics, Sensors (ogre2) and Imu systems. -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${d['wheel_separation']}</wheel_separation>
      <wheel_radius>${d['wheel_radius']}</wheel_radius>
      <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_velocity>${d['max_linear_velocity']}</max_linear_velocity>
      <min_linear_velocity>${-d['max_linear_velocity']}</min_linear_velocity>
      <max_angular_velocity>${d['max_angular_velocity']}</max_angular_velocity>
      <min_angular_velocity>${-d['max_angular_velocity']}</min_angular_velocity>
      <max_linear_acceleration>${d['max_linear_acceleration']}</max_linear_acceleration>
      <min_linear_acceleration>${-d['max_linear_acceleration']}</min_linear_acceleration>
      <max_angular_acceleration>${d['max_angular_acceleration']}</max_angular_acceleration>
      <min_angular_acceleration>${-d['max_angular_acceleration']}</min_angular_acceleration>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <joint_name>left_wheel_joint</joint_name><joint_name>right_wheel_joint</joint_name>
      <joint_name>wheel_drop_left_joint</joint_name><joint_name>wheel_drop_right_joint</joint_name>
      <topic>/joint_states</topic><update_rate>50</update_rate>
    </plugin>
  </gazebo>
  <!-- Sensor-bearing fixed joints are already preserved by upstream. -->
  <gazebo reference="rplidar_link">
    <sensor name="rplidar" type="gpu_lidar">
      <topic>/scan</topic><ignition_frame_id>rplidar_link</ignition_frame_id>
      <always_on>true</always_on><visualize>false</visualize><update_rate>${d['lidar_rate']}</update_rate>
      <lidar>
        <scan><horizontal><samples>${d['lidar_samples']}</samples><resolution>1</resolution><min_angle>${-pi}</min_angle><max_angle>${pi}</max_angle></horizontal></scan>
        <range><min>${d['lidar_min_range']}</min><max>${d['lidar_max_range']}</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/imu</topic><ignition_frame_id>imu_link</ignition_frame_id>
      <always_on>true</always_on><update_rate>${d['imu_rate']}</update_rate>
    </sensor>
  </gazebo>
  <xacro:if value="$(arg enable_camera)">
    <gazebo reference="oakd_rgb_camera_frame">
      <sensor name="rgbd_camera" type="rgbd_camera">
        <topic>/camera</topic><ignition_frame_id>oakd_rgb_camera_optical_frame</ignition_frame_id>
        <always_on>true</always_on><update_rate>${d['camera_rate']}</update_rate>
        <camera>
          <camera_info_topic>/camera/camera_info</camera_info_topic>
          <optical_frame_id>oakd_rgb_camera_optical_frame</optical_frame_id>
          <horizontal_fov>${d['camera_horizontal_fov']}</horizontal_fov>
          <image><width>${d['camera_width']}</width><height>${d['camera_height']}</height><format>R8G8B8</format></image>
          <clip><near>${d['camera_near_clip']}</near><far>${d['camera_far_clip']}</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>
</robot>
